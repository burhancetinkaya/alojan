# Configure the public endpoint privately; no deployed or sample MCP URL is stored here.
# Never put personal tokens in deployment config. Users issue their own in the UI.
ALOJAN_MCP_PUBLIC_URL=
ALOJAN_MANAGEMENT_URL=http://127.0.0.1:18081
ALOJAN_MCP_BIND=127.0.0.1
ALOJAN_MCP_PORT=18082
# Set in the management API's private environment too:
# ALOJAN_PUBLIC_ORIGIN=
# ALOJAN_MCP_PUBLIC_URL=
# Only with the loopback-only ingress/API topology: use Cloudflare's client IP
# for browser authentication budgets instead of grouping every visitor together.
# ALOJAN_TRUSTED_PROXY_IPS=127.0.0.1

# Copy the Nginx template outside Git and set the real host there.
ALOJAN_MCP_NGINX_CONFIG=
