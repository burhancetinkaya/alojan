# Copy outside Git. Match the password/URL to the private state's dev.env.
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=15432
ALOJAN_DATABASE_URL=postgresql://alojan:replace-with-a-local-secret@127.0.0.1:15432/alojan

# Absolute directory containing private env files and prepared model caches.
ALOJAN_STATE_DIR=/srv/alojan/state
ALOJAN_RELEASE=dev-1
ALOJAN_UID=1000
ALOJAN_GID=1000
ALOJAN_GPU_DEVICE=0
